diff --git a/include/linux/oscdk_proc.h b/include/linux/oscdk_proc.h
new file mode 100644
--- /dev/null
+++ b/include/linux/oscdk_proc.h
@@ -0,0 +1,29 @@
+#ifndef _OSCDK_PROC_H
+#define _OSCDK_PROC_H
+
+#include <linux/types.h>
+
+#define PROC_INFO_MAX      1024
+#define PROC_SNAPSHOT_BUF  8192
+
+#ifndef TASK_COMM_LEN
+#define TASK_COMM_LEN      16
+#endif
+
+struct proc_info {
+	pid_t pid;
+	char comm[TASK_COMM_LEN];
+	long state;		/* task->__state */
+	unsigned long utime;	/* 用户态 tick 数 */
+	unsigned long stime;	/* 内核态 tick 数 */
+	unsigned long vsize;	/* 虚拟内存页数 (total_vm) */
+};
+
+struct proc_stat {
+	int total;
+	int running;
+	int sleeping;
+	int uninterruptible;
+	int zombie;
+	int stopped;
+	int other;
+};
+
+#endif /* _OSCDK_PROC_H */
diff --git a/kernel/oscdk_proc.c b/kernel/oscdk_proc.c
new file mode 100644
--- /dev/null
+++ b/kernel/oscdk_proc.c
@@ -0,0 +1,273 @@
+#include <linux/kernel.h>
+#include <linux/syscalls.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/uaccess.h>
+#include <linux/slab.h>
+#include <linux/rcupdate.h>
+#include <linux/mm.h>
+#include <linux/list.h>
+#include <linux/pid.h>
+#include <linux/oscdk_proc.h>
+
+/* ============ proc_collect (548) ============ */
+SYSCALL_DEFINE2(proc_collect,
+		struct proc_info __user *, ubuf,
+		size_t, max_count)
+{
+	struct proc_info *kbuf;
+	struct task_struct *task;
+	size_t count = 0;
+	int ret;
+
+	if (!ubuf || max_count == 0)
+		return -EINVAL;
+
+	if (max_count > PROC_INFO_MAX)
+		max_count = PROC_INFO_MAX;
+
+	kbuf = kmalloc_array(max_count, sizeof(struct proc_info), GFP_KERNEL);
+	if (!kbuf)
+		return -ENOMEM;
+
+	rcu_read_lock();
+	for_each_process(task) {
+		if (count >= max_count)
+			break;
+		/* 只收集线程组领导，避免同一进程的多个线程被重复计入 */
+		if (task->tgid != task->pid)
+			continue;
+		kbuf[count].pid = task_tgid_nr(task);
+		strncpy(kbuf[count].comm, task->comm, TASK_COMM_LEN);
+		kbuf[count].comm[TASK_COMM_LEN - 1] = '\0';
+		kbuf[count].state = task->__state;
+		kbuf[count].utime = task->utime;
+		kbuf[count].stime = task->stime;
+		kbuf[count].vsize = (task->mm) ? task->mm->total_vm : 0;
+		count++;
+	}
+	rcu_read_unlock();
+
+	if (copy_to_user(ubuf, kbuf, count * sizeof(struct proc_info)))
+		ret = -EFAULT;
+	else
+		ret = count;
+
+	kfree(kbuf);
+	return ret;
+}
+
+/* ============ proc_snapshot (549) ============ */
+
+struct snapshot_node {
+	pid_t pid;
+	pid_t ppid;
+	char comm[TASK_COMM_LEN];
+	struct snapshot_node *parent;
+	bool is_last;
+	struct list_head list;
+	struct list_head children;
+	struct list_head sibling;
+	struct list_head queue;
+};
+
+static void free_snapshot_nodes(struct list_head *head)
+{
+	struct snapshot_node *node, *tmp;
+	list_for_each_entry_safe(node, tmp, head, list) {
+		list_del(&node->list);
+		kfree(node);
+	}
+}
+
+SYSCALL_DEFINE2(proc_snapshot,
+		char __user *, ubuf,
+		size_t, size)
+{
+	struct task_struct *task;
+	struct snapshot_node *node, *root = NULL, *iter;
+	char *kbuf;
+	size_t buf_size, written = 0;
+	int ret = 0;
+	LIST_HEAD(node_list);
+	LIST_HEAD(queue);
+
+	if (!ubuf || size == 0)
+		return -EINVAL;
+
+	buf_size = min(size, (size_t)PROC_SNAPSHOT_BUF);
+	kbuf = kmalloc(buf_size, GFP_KERNEL);
+	if (!kbuf)
+		return -ENOMEM;
+
+	rcu_read_lock();
+	for_each_process(task) {
+		/* 只收集线程组领导，避免多线程造成父子关系混乱 */
+		if (task->tgid != task->pid)
+			continue;
+		node = kmalloc(sizeof(*node), GFP_ATOMIC);
+		if (!node) {
+			rcu_read_unlock();
+			free_snapshot_nodes(&node_list);
+			kfree(kbuf);
+			return -ENOMEM;
+		}
+		node->pid = task_tgid_nr(task);
+		node->ppid = task_tgid_nr(rcu_dereference(task->real_parent));
+		strncpy(node->comm, task->comm, TASK_COMM_LEN);
+		node->comm[TASK_COMM_LEN - 1] = '\0';
+		node->parent = NULL;
+		node->is_last = false;
+		INIT_LIST_HEAD(&node->children);
+		INIT_LIST_HEAD(&node->sibling);
+		INIT_LIST_HEAD(&node->queue);
+		list_add_tail(&node->list, &node_list);
+	}
+	rcu_read_unlock();
+
+	list_for_each_entry(node, &node_list, list) {
+		if (node->pid == 1) {
+			root = node;
+			continue;
+		}
+		list_for_each_entry(iter, &node_list, list) {
+			if (iter->pid == node->ppid) {
+				list_add_tail(&node->sibling, &iter->children);
+				node->parent = iter;
+				break;
+			}
+		}
+	}
+	if (!root) {
+		root = list_first_entry_or_null(&node_list,
+				struct snapshot_node, list);
+		if (!root) {
+			kfree(kbuf);
+			free_snapshot_nodes(&node_list);
+			return -ESRCH;
+		}
+	}
+
+	/* 标记每个父节点孩子链中的最后一个节点 */
+	list_for_each_entry(node, &node_list, list) {
+		if (!list_empty(&node->children)) {
+			struct snapshot_node *child, *last;
+			list_for_each_entry(child, &node->children, sibling)
+				child->is_last = false;
+			last = list_last_entry(&node->children,
+						   struct snapshot_node, sibling);
+			last->is_last = true;
+		}
+	}
+
+	/* BFS 生成带缩进线的进程树 */
+	INIT_LIST_HEAD(&queue);
+	list_add_tail(&root->queue, &queue);
+	written = 0;
+
+	while (!list_empty(&queue)) {
+		struct snapshot_node *cur = list_first_entry(&queue,
+				struct snapshot_node, queue);
+		struct snapshot_node *child;
+		int i, len;
+
+		list_del_init(&cur->queue);
+
+		if (cur == root) {
+			len = snprintf(kbuf + written, buf_size - written,
+				       "%s(%d)\n", cur->comm, cur->pid);
+			if (len >= buf_size - written) goto trunc;
+			written += len;
+		} else {
+			struct snapshot_node *ancestors[64];
+			int anc_count = 0;
+			struct snapshot_node *p = cur->parent;
+			while (p != root && anc_count < 64) {
+				ancestors[anc_count++] = p;
+				p = p->parent;
+			}
+			for (i = anc_count - 1; i >= 0; i--) {
+				const char *indent = ancestors[i]->is_last ?
+							 "   " : "│  ";
+				len = snprintf(kbuf + written, buf_size - written,
+					       "%s", indent);
+				if (len >= buf_size - written) goto trunc;
+				written += len;
+			}
+			const char *prefix = cur->is_last ? "└─" : "├─";
+			len = snprintf(kbuf + written, buf_size - written,
+				       "%s", prefix);
+			if (len >= buf_size - written) goto trunc;
+			written += len;
+			len = snprintf(kbuf + written, buf_size - written,
+				       "%s(%d)\n", cur->comm, cur->pid);
+			if (len >= buf_size - written) goto trunc;
+			written += len;
+		}
+
+		list_for_each_entry(child, &cur->children, sibling) {
+			list_add_tail(&child->queue, &queue);
+		}
+		continue;
+
+trunc:
+		kbuf[buf_size - 1] = '\0';
+		ret = -EMSGSIZE;
+		goto out_copy;
+	}
+
+out_copy:
+	if (written >= buf_size) {
+		kbuf[buf_size - 1] = '\0';
+		ret = -EMSGSIZE;
+	}
+	if (copy_to_user(ubuf, kbuf, min(written + 1, buf_size))) {
+		ret = -EFAULT;
+	} else if (ret == 0) {
+		ret = written;
+	}
+
+	kfree(kbuf);
+	free_snapshot_nodes(&node_list);
+	return ret;
+}
+
+/* ============ proc_stat (550) ============ */
+SYSCALL_DEFINE1(proc_stat,
+		struct proc_stat __user *, ubuf)
+{
+	struct task_struct *task;
+	struct proc_stat stat = {0};
+	int ret;
+
+	if (!ubuf)
+		return -EINVAL;
+
+	rcu_read_lock();
+	for_each_process(task) {
+		/* 只统计线程组领导，避免线程重复计数 */
+		if (task->tgid != task->pid)
+			continue;
+		long state = task->__state;
+		stat.total++;
+		if (state == TASK_RUNNING)
+			stat.running++;
+		else if (state & TASK_INTERRUPTIBLE)
+			stat.sleeping++;
+		else if (state & TASK_UNINTERRUPTIBLE)
+			stat.uninterruptible++;
+		else if (task->exit_state & EXIT_ZOMBIE)
+			stat.zombie++;
+		else if (task->exit_state & EXIT_DEAD)
+			;
+		else if (state & TASK_STOPPED)
+			stat.stopped++;
+		else
+			stat.other++;
+	}
+	rcu_read_unlock();
+
+	if (copy_to_user(ubuf, &stat, sizeof(stat)))
+		return -EFAULT;
+	return 0;
+}
